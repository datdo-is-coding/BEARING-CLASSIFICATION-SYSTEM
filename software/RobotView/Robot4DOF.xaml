<UserControl x:Class="RobotView.Robot4DOF"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
             xmlns:local="clr-namespace:RobotView"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.DataContext>
        <local:MainViewModel/>
    </UserControl.DataContext>
    <Grid>

        <hx:Viewport3DX
            x:Name="viewport"
            BackgroundColor="Gray"
            EffectsManager="{Binding EffectsManager}"
            Camera="{Binding camera}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">

            <!-- Lighting -->
            <hx:DirectionalLight3D
                Direction="0,0,-1"
                Color="White"/>

            <hx:DirectionalLight3D
                Direction="-1,-1,-1"
                Color="LightGray"/>

            <hx:DirectionalLight3D
                Direction="1,1,1"
                Color="LightGray"/>

            <hx:DirectionalLight3D
                Direction="1,0,0"
                Color="LightGray"/>

            <hx:DirectionalLight3D
                Direction="-1,0,0"
                Color="LightGray"/>


            <!-- Robot -->
            <hx:SceneNodeGroupModel3D
                x:Name="RobotScene"/>


            <!-- Grid -->
            <hx:LineGeometryModel3D
                Geometry="{Binding LineMesh}"
                Thickness="1"
                Color="Black"/>


            <!-- Coordinate system -->
            <hx:CoordinateSystemModel3D
                x:Name="CoordinateSystem"
                SizeScale="1"/>


           

        

        </hx:Viewport3DX>

    </Grid>

</UserControl>